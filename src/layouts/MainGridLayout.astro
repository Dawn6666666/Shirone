---
import ImageWrapper from "@components/molecules/ImageWrapper.astro";
import BackToTop from "@components/organisms/BackToTop.astro";
import CategoryBar from "@components/organisms/CategoryBar.astro";
import Footer from "@components/organisms/Footer.astro";
import RouteProgress from "@components/organisms/RouteProgress.svelte";
import SideBar from "@components/organisms/SideBar.astro";
import SiteNavigationDrawer from "@components/organisms/SiteNavigationDrawer.svelte";
import TopAppBar from "@components/organisms/TopAppBar.astro";
import type { SidebarPage } from "@/types/sidebarConfig";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import {
	generateGridClasses,
	generateMainContentClasses,
	generatePrimarySidebarClasses,
	generateSecondarySidebarClasses,
	getResponsiveSidebarConfig,
	isDualColumn,
} from "@utils/responsive-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	/** 文章页所属分类名，透传给 CategoryBar 做弱高亮 */
	postCategory?: string;
	/** 当前页面标识符（SidebarPage），透传给 SideBar 做 pages 过滤，并输出到
	 *  #swup-container 的 data-current-page——Swup 替换容器时同步该属性，
	 *  侧栏据此在站内导航后重新过滤 */
	page?: SidebarPage;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	postCategory,
	page,
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";

// 响应式侧栏配置（数据驱动布局）
const sidebarResponsive = getResponsiveSidebarConfig();
const gridClasses = generateGridClasses(sidebarResponsive);
const sidebarClasses = generatePrimarySidebarClasses(sidebarResponsive);
const secondarySidebarClasses = generateSecondarySidebarClasses(sidebarResponsive);
const mainContentClasses = generateMainContentClasses(sidebarResponsive);
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<header id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <TopAppBar></TopAppBar>
    </div>
</header>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper>
</div>}

<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class:list={["transition duration-700 w-full left-0 right-0 grid grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4", gridClasses]}>
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[var(--primary)] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


            <SideBar class={sidebarClasses} currentPage={page} headings={headings}></SideBar>
			{isDualColumn(sidebarResponsive) && (
				<SideBar id="sidebar-secondary" column="secondary" class={secondarySidebarClasses} currentPage={page} headings={headings}></SideBar>
			)}

            <!-- 主内容列：分类导航栏静态渲染（位于 Swup 容器外），
                 页面切换时保持固定不重渲染；仅内容区随导航替换 -->
            <div class={mainContentClasses.replace("transition-swup-fade", "").trim()}>
                <CategoryBar currentPostCategory={postCategory}></CategoryBar>
                <main
                    id="swup-container"
                    data-current-post-category={postCategory || ""}
                    data-current-page={page}
                    class="transition-swup-fade"
                >
                    <div id="content-wrapper" class="onload-animation">
                        <!-- the overflow-hidden here prevent long text break the layout-->
                        <!-- make id different from windows.swup global property -->
                        <slot></slot>
                        <div class="footer col-span-2 onload-animation hidden lg:block">
                            <Footer></Footer>
                        </div>
                    </div>
                </main>
            </div>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
        <RouteProgress client:load />
    </div>
</div>

<SiteNavigationDrawer client:load />

</Layout>
