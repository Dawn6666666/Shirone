---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";

import Snackbar from "@components/atoms/overlay/Snackbar.svelte";
import ConfigCarrier from "@components/system/ConfigCarrier.astro";
import { expressiveCodeConfig, profileConfig, siteConfig } from "@/config";
import type { SidebarPage } from "@/types/sidebarConfig";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { resolvePageWidth } from "../utils/responsive-utils";
import { pathsEqual, url } from "../utils/url-utils";
import "katex/dist/katex.css";
import "overlayscrollbars/overlayscrollbars.css";
import "../styles/main.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	page?: SidebarPage;
}

let { title, description, lang, setOGTypeArticle, page } = Astro.props;

const initialPage =
	page ?? (pathsEqual(Astro.url.pathname, url("/")) ? "home" : undefined);

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
const lightTheme =
	expressiveCodeConfig.lightTheme ?? expressiveCodeConfig.theme;
const darkTheme = expressiveCodeConfig.darkTheme ?? expressiveCodeConfig.theme;
const defaultWallpaperMode = siteConfig.wallpaperMode.defaultMode;
const hasDesktopBanner = siteConfig.banner.src.desktop.length > 0;
const hasMobileBanner = siteConfig.banner.src.mobile.length > 0;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px]">
	<head>
		<!-- Fix the CSS cascade-layer order. Tailwind's `base` layer (preflight resets like `button { color: inherit }`)
		     must precede `components`, otherwise component classes like `.btn-plain` lose to the resets in dark mode. -->
		<style is:inline>@layer properties, theme, base, components, utilities;</style>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle}>
		<meta name="author" content={profileConfig.name}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description || pageTitle}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description || pageTitle}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
			<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, configHue, lightTheme, darkTheme, defaultWallpaperMode}}>
			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			let isDark = false;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					isDark = true;
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
						isDark = true;
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// Set the theme for Expressive Code (light/dark code block themes)
			document.documentElement.setAttribute('data-theme', isDark ? darkTheme : lightTheme);

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);

			// Apply reduced-motion preference before paint to avoid animation flash
				if (localStorage.getItem('mc-motion') === 'reduced') {
					document.documentElement.classList.add('motion-reduced');
				}

				// Apply wallpaper preference before paint.
				const storedWallpaperMode = localStorage.getItem('wallpaper-mode');
				const wallpaperMode = storedWallpaperMode === 'banner' || storedWallpaperMode === 'none'
					? storedWallpaperMode
					: defaultWallpaperMode;
				document.documentElement.dataset.wallpaperMode = wallpaperMode;

				// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
				let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<style define:vars={{
			configHue,
			// 页框宽度按侧栏编排自动解析（single 85rem / dual 96rem）
			'page-width': resolvePageWidth(),
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

	</head>
		<body
			class="min-h-screen transition"
			data-current-page={initialPage}
			data-banner-visible="false"
			data-banner-layout="compact"
			data-banner-top-app-bar="false"
			data-banner-has-desktop={String(hasDesktopBanner)}
			data-banner-has-mobile={String(hasMobileBanner)}
		>
		<ConfigCarrier></ConfigCarrier>
		<Snackbar client:only="svelte"></Snackbar>
		<slot />

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
	</body>
</html>

<style lang="stylus" is:global>
@import "../styles/variables.styl"
</style>

<style is:global define:vars={{
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
	'banner-panel-overlap': `${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem`,
}}>
@reference "../styles/main.css";
		@layer components {
			:root {
				--banner-stage-height: var(--banner-height-home);
				--banner-content-top: calc(var(--banner-stage-height) - var(--banner-panel-overlap));
			}

			#main-layout {
				top: 5.5rem;
				transition: top var(--m3e-duration-long) var(--m3e-easing-standard);
			}

			body[data-banner-layout="banner"] #main-layout {
				top: var(--banner-content-top);
			}

				body[data-banner-layout="banner"] #top-row {
					height: calc(var(--banner-stage-height) - 4.5rem);
				}

				.navbar-hidden {
					opacity: 0;
					transform: translateY(-4rem);
				}
			}

			@media (min-width: 1024px) {
				html[data-wallpaper-mode="banner"] body[data-banner-has-desktop="true"] #main-layout {
					top: var(--banner-content-top);
				}

				html[data-wallpaper-mode="banner"] body[data-banner-has-desktop="true"] #top-row {
					height: calc(var(--banner-stage-height) - 4.5rem);
				}
			}

		@media (max-width: 1023.98px) {
				:root {
					--banner-stage-height: max(70vh, 28rem);
				}

				@media (max-width: 479.98px) {
					:root {
						--banner-panel-overlap: var(--m3e-space-8);
					}
				}

				@media (min-width: 480px) and (max-width: 767.98px) {
					:root {
						--banner-panel-overlap: var(--m3e-space-10);
					}
				}

			html[data-wallpaper-mode="banner"] body[data-current-page="home"][data-banner-has-mobile="true"] #main-layout {
				top: var(--banner-content-top);
			}

			html[data-wallpaper-mode="banner"] body[data-current-page="home"][data-banner-has-mobile="true"] #top-row {
				height: calc(var(--banner-stage-height) - 4.5rem);
			}

			body[data-banner-layout="compact"] #top-row {
				height: auto;
			}
		}


	@media (min-width: 480px) and (max-width: 767.98px) {
		:root {
			--banner-stage-height: max(75vh, 31.25rem);
		}
	}

	@media (min-width: 768px) and (max-width: 1023.98px) {
		:root {
			--banner-stage-height: max(70vh, 31.25rem);
		}
	}

</style>

<script>
import "../utils/code-collapse";
import { initLastUpdatedNotices } from "../utils/last-updated-notice";
import { initMermaidDiagrams } from "../utils/mermaid";
import {
	OverlayScrollbars,
	// ScrollbarsHidingPlugin,
	// SizeObserverPlugin,
	// ClickScrollPlugin
} from 'overlayscrollbars';
import {getHue, getStoredTheme, setHue, setTheme} from "../utils/setting-utils";
import { WALLPAPER_MODE_CHANGE_EVENT } from "../constants/constants";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
} from "../constants/constants";

/* Preload fonts */
// (async function() {
// 	try {
// 		await Promise.all([
// 			document.fonts.load("400 1em Roboto"),
// 			document.fonts.load("700 1em Roboto"),
// 		]);
// 		document.body.classList.remove("hidden");
// 	} catch (error) {
// 		console.log("Failed to load fonts:", error);
// 	}
// })();

/* TODO This is a temporary solution for style flicker issue when the transition is activated */
/* issue link: https://github.com/withastro/astro/issues/8711, the solution get from here too */
/* update: fixed in Astro 3.2.4 */
