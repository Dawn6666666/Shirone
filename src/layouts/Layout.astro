*/

function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;		// Ensure the event target is an HTML Node
		for (let ig of ignores) {
			let ie = document.getElementById(ig)
			if (ie == tDom || (ie?.contains(tDom))) {
				return;
			}
		}
		// 面板元素不存在（如无顶栏/面板的独立页面）时跳过，避免 null.classList
		if (panelDom) panelDom.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])


function loadTheme() {
	const theme = getStoredTheme()
	setTheme(theme)
}

function loadHue() {
	setHue(getHue())
}

function initCustomScrollbar() {
	// Keep the document on its native root scroller. Wrapping body with
	// OverlayScrollbars can leave it locked after viewport mode changes.
	const katexElements = document.querySelectorAll('.katex-display') as NodeListOf<HTMLElement>;

	const katexObserverOptions = {
		root: null,
		rootMargin: '100px',
		threshold: 0.1
	};

	const processKatexElement = (element: HTMLElement) => {
		if (!element.parentNode) return;
		if (element.hasAttribute('data-scrollbar-initialized')) return;

		const container = document.createElement('div');
		container.className = 'katex-display-container';
		container.setAttribute('aria-label', 'scrollable container for formulas');

		element.parentNode.insertBefore(container, element);
		container.appendChild(element);

		OverlayScrollbars(container, {
			scrollbars: {
				theme: 'scrollbar-base scrollbar-auto',
				autoHide: 'leave',
				autoHideDelay: 500,
				autoHideSuspend: false
			}
		});

		element.setAttribute('data-scrollbar-initialized', 'true');
	};

	const katexObserver = new IntersectionObserver((entries, observer) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
			processKatexElement(entry.target as HTMLElement);
			observer.unobserve(entry.target);
			}
		});
	}, katexObserverOptions);

	katexElements.forEach(element => {
		katexObserver.observe(element);
	});
}

function init() {
	loadTheme();
	loadHue();
	initCustomScrollbar();
}

/* Load settings when entering the site */
init();
initLastUpdatedNotices();
initMermaidDiagrams();

const setup = () => {
	if (!window.swup || window.__shironeNavigationBound) return;
	window.__shironeNavigationBound = true;
	let scrollStarted = false;
	let visitActive = false;
	let finishTimer: number | undefined;

	function finishVisit() {
		if (!visitActive) return;
		visitActive = false;
		window.clearTimeout(finishTimer);
		finishTimer = window.setTimeout(() => {
			document.getElementById('page-height-extend')?.classList.add('hidden');
			document.getElementById('toc-wrapper')?.classList.remove('toc-not-ready');
		}, 200);
	}

	window.swup?.hooks.on('link:click', () => {
		// Remove the delay for the first time page load
		document.documentElement.style.setProperty('--content-delay', '0ms')
	})
	window.swup?.hooks.on('content:replace', initCustomScrollbar)
	window.swup?.hooks.on('visit:start', () => {
		window.clearTimeout(finishTimer);
		visitActive = true;
		scrollStarted = false;

		// Keep enough document height until Swup's scroll animation has ended.
		document.getElementById('page-height-extend')?.classList.remove('hidden');
		document.getElementById('toc-wrapper')?.classList.add('toc-not-ready');
	});
	window.swup?.hooks.on('visit:end', () => {
		// scroll:start/end are skipped when the page is already at its target position.
		if (!scrollStarted) finishVisit();
	});
	window.swup?.hooks.on('visit:abort', finishVisit);
	if (window.swup?.hooks.exists('scroll:end')) {
		window.swup.hooks.on('scroll:start', () => {
			if (visitActive) scrollStarted = true;
		});
		window.swup.hooks.on('scroll:end', finishVisit);
	}
}
if (window.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup, { once: true })
}

let backToTopBtn = document.getElementById('back-to-top-btn');
let toc = document.getElementById('toc-wrapper');

function scrollFunction() {
	const scrollTop = Math.max(document.body.scrollTop, document.documentElement.scrollTop);
	const backToTopThreshold = window.innerHeight * (BANNER_HEIGHT / 100);

	if (backToTopBtn) {
		backToTopBtn.classList.toggle('hide', scrollTop <= backToTopThreshold);
	}

	const bannerVisible = document.body.dataset.bannerVisible === 'true';
	if (toc) {
		toc.classList.toggle('toc-hide', bannerVisible && scrollTop <= backToTopThreshold);
	}

	const navbar = document.getElementById('navbar');
	const bannerStage = document.getElementById('banner-wrapper');
	const bannerBottom = bannerStage?.getBoundingClientRect().height ?? 0;
	const overBanner = bannerVisible && scrollTop < Math.max(0, bannerBottom - 64);
	document.body.dataset.bannerScrolled = String(!overBanner);
	navbar?.classList.toggle('top-app-bar--transparent', overBanner);
}

window.addEventListener('scroll', scrollFunction, { passive: true });
window.addEventListener('resize', () => {
	// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - offset % 4;
	document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
	scrollFunction();
});

new MutationObserver(scrollFunction).observe(document.body, {
	attributes: true,
	attributeFilter: ['data-banner-visible', 'data-banner-layout'],
});
window.addEventListener(WALLPAPER_MODE_CHANGE_EVENT, () => requestAnimationFrame(scrollFunction));
document.addEventListener('swup:page:view', scrollFunction);
scrollFunction();
</script>

<script>
import { cleanupFancybox, initFancybox } from "../utils/fancybox-handler";
import { applyStoredLayoutMode } from "../utils/layout-mode";

const setup = () => {
	initFancybox();

	window.swup.hooks.on("visit:start", () => {
		cleanupFancybox();
	});

	window.swup.hooks.on("content:replace", () => {
		initFancybox();
		// swup 替换内容后，SSR 输出的是站点默认布局模式，重新应用访客偏好
		applyStoredLayoutMode(document.getElementById("post-list"));
	});
};

if (window.swup) {
	setup();
} else {
	document.addEventListener("swup:enable", setup);
}
</script>
