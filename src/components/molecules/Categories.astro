---
/**
 * 分类侧栏组件（消费 blog/CategoryList 原子）。
 * 只负责取数转 props：分类名 + URL + 计数。
 */
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import CategoryList from "@components/atoms/blog/CategoryList.astro";
import type { CategoriesWidget } from "@/types/sidebarConfig";
import { getCategoryList } from "../../utils/content-utils";
import WidgetLayout from "./WidgetLayout.astro";

const categories = await getCategoryList();

const COLLAPSED_HEIGHT = "7.5rem";

interface Props {
	class?: string;
	style?: string;
	widget?: CategoriesWidget;
}
const className = Astro.props.class;
const style = Astro.props.style;

const COLLAPSE_THRESHOLD = Astro.props.widget?.collapseAfter ?? 5;
const isCollapsed = categories.length >= COLLAPSE_THRESHOLD;

const categoryItems = categories.map((c) => ({
	name: c.name.trim(),
	href: c.url,
	count: c.count,
}));
---

<WidgetLayout name={i18n(I18nKey.categories)} id="categories" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT}
                class={className} style={style}
>
	<CategoryList categories={categoryItems} />
</WidgetLayout>
