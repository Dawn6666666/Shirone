---
/**
 * 标签侧栏组件（消费 blog/TagList 原子）。
 * 只负责取数转 props：标签名 + 标签 URL。
 */
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import TagList from "@components/atoms/blog/TagList.astro";
import type { TagsWidget } from "@/types/sidebarConfig";
import { getTagList } from "../../utils/content-utils";
import { getTagUrl } from "../../utils/url-utils";
import WidgetLayout from "./WidgetLayout.astro";

const tags = await getTagList();

const COLLAPSED_HEIGHT = "7.5rem";

interface Props {
	class?: string;
	style?: string;
	widget?: TagsWidget;
}
const className = Astro.props.class;
const style = Astro.props.style;

const COLLAPSE_THRESHOLD = Astro.props.widget?.collapseAfter ?? 20;
const isCollapsed = tags.length >= COLLAPSE_THRESHOLD;

const tagItems = tags.map((t) => ({
	name: t.name.trim(),
	href: getTagUrl(t.name),
}));
---
<WidgetLayout name={i18n(I18nKey.tags)} id="tags" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT} class={className} style={style}>
	<TagList tags={tagItems} />
</WidgetLayout>
