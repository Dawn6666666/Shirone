---
/**
 * M3E IconButton — M3 图标按钮原子（40px）。
 * variant: standard（透明）/ tonal（次级容器）/ filled（主色）。
 */
interface Props {
	variant?: "standard" | "tonal" | "filled";
	disabled?: boolean;
	type?: "button" | "submit" | "reset";
	label: string;
	id?: string;
	/** 提供时渲染为 <a>（外部社交链接等） */
	href?: string;
	target?: string;
	rel?: string;
	class?: string;
}

const {
	variant = "standard",
	disabled = false,
	type = "button",
	label,
	id,
	href,
	target,
	rel,
	class: className,
} = Astro.props;

const classList = [
	"m3-icon-button",
	"m3-state-layer",
	`m3-icon-button--${variant}`,
	className,
];
---

{
	href ? (
		<a id={id} href={href} target={target} rel={rel} aria-label={label} class:list={classList}>
			<slot />
		</a>
	) : (
		<button
			id={id}
			type={type}
			disabled={disabled}
			aria-label={label}
			class:list={classList}
		>
			<slot />
		</button>
	)
}

<style lang="stylus">
.m3-icon-button
  width: 2.5rem
  height: 2.5rem
  border-radius: var(--shape-corner-full)
  border: none
  display: inline-flex
  align-items: center
  justify-content: center
  cursor: pointer
  user-select: none
  text-decoration: none
  font-size: 1.25rem
  line-height: 1

  &--standard
    background: transparent
    color: var(--on-surface-variant)
    --m3e-state-color: var(--on-surface)

  &--tonal
    background: var(--secondary-container)
    color: var(--on-secondary-container)
    --m3e-state-color: var(--on-secondary-container)

  &--filled
    background: var(--primary)
    color: var(--on-primary)
    --m3e-state-color: var(--on-primary)
</style>
