---
/**
 * M3E FAB — M3 悬浮操作按钮（small 40px / regular 56px）。
 * 容器用 primary-container，高度 level 3，圆角 shape-corner-l。
 * 图标由插槽提供（推荐 24px 图标）。
 */
interface Props {
	size?: "small" | "regular";
	disabled?: boolean;
	type?: "button" | "submit" | "reset";
	label: string;
	class?: string;
}

const { size = "regular", disabled = false, type = "button", label, class: className } = Astro.props;
---

<button
    type={type}
    disabled={disabled}
    aria-label={label}
    class:list={[
        "m3-fab",
        "m3-state-layer",
        `m3-fab--${size}`,
        className,
    ]}
>
    <slot />
</button>

<style lang="stylus">
.m3-fab
  border: none
  border-radius: var(--shape-corner-l)
  background: var(--primary-container)
  color: var(--on-primary-container)
  --m3e-state-color: var(--on-primary-container)
  box-shadow: var(--m3e-elevation-3)
  display: inline-flex
  align-items: center
  justify-content: center
  cursor: pointer
  user-select: none
  font-size: 1.5rem
  line-height: 1
  transition: box-shadow var(--m3e-duration-short) var(--m3e-easing-standard)
  &:hover
    box-shadow: var(--m3e-elevation-4)

  &--small
    width: 2.5rem
    height: 2.5rem
    font-size: 1.25rem
  &--regular
    width: 3.5rem
    height: 3.5rem
</style>
