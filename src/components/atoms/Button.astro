---
/**
 * M3E Button — M3 按钮原子（filled / tonal / outlined / text）。
 * 形状跟随站内风格：默认 12px 圆角（--shape-corner-m），M3 胶囊用 class="rounded-full!" 覆盖。
 * 状态层走全局 .m3-state-layer（hover 8% / focus 10% / pressed 12%）。
 * 提供 href 时渲染 <a>（用于导航链接，避免 a>button 非法嵌套）。
 */
interface Props {
	/** M3 按钮变体。text 变体为中性文字 + primary 状态层（还原站内 nav 链接观感） */
	variant?: "filled" | "tonal" | "outlined" | "text";
	/** 高度：small 32px / medium 40px / large 48px */
	size?: "small" | "medium" | "large";
	disabled?: boolean;
	type?: "button" | "submit" | "reset";
	/** aria-label，图标按钮等无文字时使用 */
	label?: string;
	/** 提供时渲染为 <a> */
	href?: string;
	target?: string | null;
	/** 占满容器宽度 */
	full?: boolean;
	/** 内容对齐：center / start（左）/ between（标题左、徽标右） */
	align?: "center" | "start" | "between";
	class?: string;
}

const {
	variant = "filled",
	size = "medium",
	disabled = false,
	type = "button",
	label,
	href,
	target,
	full = false,
	align = "center",
	class: className,
} = Astro.props;

const classList = [
	"m3-button",
	"m3-state-layer",
	`m3-button--${variant}`,
	`m3-button--${size}`,
	`m3-button--${align}`,
	{ "m3-button--full": full },
	className,
];
---

{
	href ? (
		<a
			href={href}
			target={target}
			aria-label={label}
			class:list={classList}
		>
			<span class="m3-button__content"><slot /></span>
		</a>
	) : (
		<button
			type={type}
			disabled={disabled}
			aria-label={label}
			class:list={classList}
		>
			<span class="m3-button__content"><slot /></span>
		</button>
	)
}

<style lang="stylus">
.m3-button
  display: inline-flex
  border: none
  cursor: pointer
  user-select: none
  text-decoration: none
  border-radius: var(--shape-corner-m)
  white-space: nowrap
  box-sizing: border-box
  /* hover 阴影提升过渡（filled/tonal） */
  transition: box-shadow var(--m3e-duration-short) var(--m3e-easing-standard)

  &__content
    display: flex
    flex: 1
    align-items: center
    gap: 0.5rem
    min-width: 0

  /* 对齐方式 */
  &--center &__content
    justify-content: center
  &--start &__content
    justify-content: flex-start
  &--between &__content
    justify-content: space-between

  &--full
    width: 100%

  /* sizes */
  &--small
    height: 2rem
    padding: 0 1rem
    font: var(--m3e-type-label-medium)
  &--medium
    height: 2.5rem
    padding: 0 1.5rem
    font: var(--m3e-type-label-large)
  &--large
    height: 3rem
    padding: 0 1.75rem
    font: var(--m3e-type-label-large)

  /* filled：主色容器，最高视觉层级 */
  &--filled
    background: var(--primary)
    color: var(--on-primary)
    --m3e-state-color: var(--on-primary)
    box-shadow: var(--m3e-elevation-1)
    &:hover
      box-shadow: var(--m3e-elevation-2)

  /* tonal：次级容器，介于 filled 与 text 之间 */
  &--tonal
    background: var(--secondary-container)
    color: var(--on-secondary-container)
    --m3e-state-color: var(--on-secondary-container)
    box-shadow: var(--m3e-elevation-1)
    &:hover
      box-shadow: var(--m3e-elevation-2)

  /* outlined：透明底 + 轮廓线 */
  &--outlined
    background: transparent
    color: var(--primary)
    --m3e-state-color: var(--primary)
    box-shadow: none
    border: 1px solid var(--outline)

  /* text：中性文字（on-surface），状态层用 primary → hover 主色叠影 */
  &--text
    background: transparent
    color: var(--on-surface)
    --m3e-state-color: var(--primary)
    box-shadow: none
</style>
