---
/**
 * M3E 博客原子 — PostCard 文章卡片。
 * 数据驱动：标题 / 描述 / 封面 / 元信息（复用 blog/PostMeta）/ 阅读时长。
 * 视觉对齐 display/Card 令牌：surface-container-high 基、corner-large、
 * hover 抬升阴影 + 标题 primary + 箭头滑出；有封面时桌面端右侧 28% 图。
 */
import { Icon } from "astro-icon/components";
import PostMeta from "./PostMeta.astro";
import type { BlogMetaLink } from "./PostMeta.astro";

interface Props {
	href: string;
	title: string;
	description?: string;
	/** 封面图地址（省略则无封面，右侧显示进入箭头按钮） */
	image?: string;
	imageAlt?: string;
	published?: string;
	updated?: string;
	category?: BlogMetaLink | null;
	tags?: BlogMetaLink[];
	/** 阅读时长展示文本（如 "5 分钟"） */
	readingTime?: string;
	class?: string;
}

const {
	href,
	title,
	description,
	image,
	imageAlt = "",
	published,
	updated,
	category = null,
	tags = [],
	readingTime,
	class: className,
} = Astro.props;

const hasCover = !!image;
---

<article
	class:list={["m3-blog-postcard", { "m3-blog-postcard--cover": hasCover }, className]}
>
	<div class="m3-blog-postcard__body">
		<a class="m3-blog-postcard__title" href={href} aria-label={title}>
			{title}
			<Icon class="m3-blog-postcard__arrow" name="material-symbols:chevron-right-rounded" />
		</a>
		{published && (
			<PostMeta
				class="m3-blog-postcard__meta"
				{published}
				{updated}
				category={category}
				tags={tags}
				hideUpdate
			/>
		)}
		{description && <p class="m3-blog-postcard__desc">{description}</p>}
		{readingTime && (
			<p class="m3-blog-postcard__reading">
				<Icon name="material-symbols:schedule-outline-rounded" />
				{readingTime}
			</p>
		)}
	</div>
	{hasCover ? (
		<a class="m3-blog-postcard__cover" href={href} aria-label={title}>
			<img src={image} alt={imageAlt} loading="lazy" />
		</a>
	) : (
		<a class="m3-blog-postcard__enter" href={href} aria-label={title}>
			<Icon name="material-symbols:chevron-right-rounded" />
		</a>
	)}
</article>

<style lang="stylus">
.m3-blog-postcard
	position: relative
	display: flex
	flex-direction: column
	box-sizing: border-box
	width: 100%
	overflow: hidden
	border-radius: var(--shape-corner-l)
	background: var(--surface-container-high)
	color: var(--on-surface)
	transition:
		box-shadow var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate),
		background-color var(--m3e-duration-medium) var(--m3e-easing-standard)
	&:hover
		box-shadow: var(--m3e-elevation-2)
		background: unquote("color-mix(in oklab, var(--on-surface) 3%, var(--surface-container-high))")

	&__body
		flex: 1
		min-width: 0
		padding: 1.5rem 1.5rem 1.25rem

	&__title
		display: flex
		align-items: center
		gap: 0.5rem
		margin: 0 0 0.75rem
		font: var(--m3e-type-title-large)
		font-weight: 700
		line-height: 1.3
		color: var(--on-surface)
		text-decoration: none
		transition: color var(--m3e-duration-short) var(--m3e-easing-standard)
		.m3-blog-postcard:hover &
			color: var(--primary)

	&__arrow
		flex-shrink: 0
		width: 1.5rem
		height: 1.5rem
		color: var(--primary)
		transition: transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate)
		.m3-blog-postcard:hover &
			transform: translateX(0.25rem)

	&__meta
		margin-bottom: 0.75rem

	&__desc
		margin: 0 0 0.75rem
		font: var(--m3e-type-body-medium)
		color: var(--on-surface-variant)
		line-height: 1.6
		display: -webkit-box
		-webkit-line-clamp: 2
		-webkit-box-orient: vertical
		overflow: hidden

	&__reading
		display: flex
		align-items: center
		gap: 0.375rem
		margin: 0
		font: var(--m3e-type-body-small)
		color: var(--on-surface-variant)
		> :global(svg)
			width: 1.125rem
			height: 1.125rem

	&__cover
		flex-shrink: 0
		display: block
		text-decoration: none
		> img
			display: block
			width: 100%
			height: 100%
			object-fit: cover
		@media (min-width: 768px)
			position: absolute
			top: 0.75rem
			right: 0.75rem
			bottom: 0.75rem
			width: 28%
			border-radius: var(--shape-corner-s)
			overflow: hidden

	&__enter
		position: absolute
		top: 0.75rem
		right: 0.75rem
		bottom: 0.75rem
		display: flex
		align-items: center
		justify-content: center
		width: 3.25rem
		border-radius: var(--shape-corner-s)
		background: var(--surface-container-lowest)
		color: var(--primary)
		text-decoration: none
		transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)
		> :global(svg)
			width: 2.25rem
			height: 2.25rem
		.m3-blog-postcard:hover &
			background: var(--primary)
			color: var(--on-primary)

	@media (min-width: 768px)
		&--cover &__body
			padding-right: calc(28% + 1.5rem)
</style>
