---
/**
 * M3E 博客原子 — PostCard 文章卡片。
 * 数据驱动：标题 / 描述 / 封面 / 元信息（复用 blog/PostMeta）/ 阅读时长。
 * 视觉对齐 display/Card 令牌：surface-container-high 基、corner-large、
 * hover 抬升阴影 + 标题 primary + 箭头滑出；有封面时桌面端右侧 28% 图。
 */
import { Icon } from "astro-icon/components";
import AccentBar from "@components/atoms/display/AccentBar.svelte";
import Skeleton from "@components/atoms/display/Skeleton.svelte";
import PostMeta from "./PostMeta.astro";
import type { BlogMetaLink } from "./PostMeta.astro";

interface Props {
	href: string;
	title: string;
	description?: string;
	/** 封面图地址（省略则无封面，右侧显示进入箭头按钮） */
	image?: string;
	imageAlt?: string;
	published?: string;
	updated?: string;
	category?: BlogMetaLink | null;
	tags?: BlogMetaLink[];
	/** 阅读时长展示文本（如 "5 分钟"） */
	readingTime?: string;
	class?: string;
	style?: string;
}

const {
	href,
	title,
	description,
	image,
	imageAlt = "",
	published,
	updated,
	category = null,
	tags = [],
	readingTime,
	class: className,
	style,
} = Astro.props;

const hasCover = !!image;
---

<article
	class:list={["m3-blog-postcard", { "m3-blog-postcard--cover": hasCover }, className]}
	style={style}
>
	<div class="m3-blog-postcard__body">
		<a class="m3-blog-postcard__title" href={href} aria-label={title}>
			<AccentBar size="medium" />
			{title}
			<Icon class="m3-blog-postcard__arrow" name="material-symbols:chevron-right-rounded" />
		</a>
		{published && (
			<PostMeta
				class="m3-blog-postcard__meta"
				{published}
				{updated}
				category={category}
				tags={tags}
				hideUpdate
				hideTagsOnMobile
			/>
		)}
		{description && <p class="m3-blog-postcard__desc">{description}</p>}
		{readingTime && (
			<p class="m3-blog-postcard__reading">
				<Icon name="material-symbols:schedule-outline-rounded" />
				{readingTime}
			</p>
		)}
	</div>
	{hasCover ? (
		<a class="m3-blog-postcard__cover" href={href} aria-label={title}>
			<Skeleton
				variant="rect"
				radius="0"
				width="100%"
				height="100%"
				class="m3-blog-postcard__cover-skeleton"
			/>
			<img src={image} alt={imageAlt} loading="lazy" />
			<span class="m3-blog-postcard__cover-mask" aria-hidden="true"></span>
			<span class="m3-blog-postcard__cover-arrow" aria-hidden="true">
				<Icon name="material-symbols:chevron-right-rounded" />
			</span>
		</a>
	) : (
		<a class="m3-blog-postcard__enter" href={href} aria-label={title}>
			<Icon name="material-symbols:chevron-right-rounded" />
		</a>
	)}
</article>

<style lang="stylus">
@import "../../../styles/breakpoints.styl"
.m3-blog-postcard
	position: relative
	display: flex
	/* 移动端封面置顶（DOM：body → cover，column-reverse 反转为 cover 在前） */
	flex-direction: column-reverse
	box-sizing: border-box
	width: 100%
	overflow: hidden
	border-radius: var(--shape-corner-l)
	/* 站点卡片色（浅色 = surface-container-lowest 近白），与侧栏等其它卡片一致 */
	background: var(--card-bg)
	color: var(--on-surface)
	transition:
		box-shadow var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate),
		background-color var(--m3e-duration-medium) var(--m3e-easing-standard)
	&:hover
		box-shadow: var(--m3e-elevation-2)
		background: unquote("color-mix(in oklab, var(--on-surface) 3%, var(--card-bg))")

	&__body
		flex: 1
		min-width: 0
		padding: 1.5rem 1.5rem 1.25rem

	&__title
		display: flex
		align-items: center
		gap: 0.5rem
		margin: 0 0 0.75rem
		font: var(--m3e-type-title-large)
		font-weight: 700
		line-height: 1.3
		color: var(--on-surface)
		text-decoration: none
		transition: color var(--m3e-duration-short) var(--m3e-easing-standard)
		.m3-blog-postcard:hover &
			color: var(--primary)

	&__arrow
		flex-shrink: 0
		width: 1.5rem
		height: 1.5rem
		color: var(--primary)
		transition: transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate)
		.m3-blog-postcard:hover &
			transform: translateX(0.25rem)

	&__meta
		margin-bottom: 0.75rem

	&__desc
		margin: 0 0 0.75rem
		font: var(--m3e-type-body-medium)
		/* 对应站点 .text-75 */
		color: unquote("color-mix(in oklab, var(--on-surface) 78%, transparent)")
		line-height: 1.6
		display: -webkit-box
		-webkit-line-clamp: 2
		-webkit-box-orient: vertical
		overflow: hidden

	&__reading
		display: flex
		align-items: center
		gap: 0.375rem
		margin: 0
		font: var(--m3e-type-body-small)
		/* 弱化次要文字（旧 text-black/30 对比度不足，用 on-surface-variant 满足 AA） */
		color: var(--on-surface-variant)
		> :global(svg)
			width: 1.125rem
			height: 1.125rem

	&__cover
		position: relative
		flex-shrink: 0
		display: block
		overflow: hidden
		text-decoration: none
		> :global(.m3-blog-postcard__cover-skeleton)
			position: absolute
			inset: 0
		> img
			display: block
			width: 100%
			height: 100%
			object-fit: cover
			position: relative

		@media (min-width: bp-md)
			position: absolute
			top: 0.75rem
			right: 0.75rem
			bottom: 0.75rem
			width: 28%
			height: auto
			border-radius: var(--shape-corner-s)
			overflow: hidden

	/* 封面触摸箭头：卡片 hover 时深色遮罩 + 白色大箭头（与原版封面一致） */
	&__cover-mask
		position: absolute
		inset: 0
		/* 触摸箭头（原版）：默认隐藏，hover/触摸时深色遮罩 + 白色大箭头 */
		background: transparent
		transition: background-color var(--m3e-duration-medium) var(--m3e-easing-standard)
		/* 移动端不显示（触摸触发的瞬时 hover 也不出现，对齐原版） */
		@media (max-width: bp-md - 1px)
			display: none
		.m3-blog-postcard:hover &
			background: unquote("color-mix(in srgb, #000 30%, transparent)")

	&__cover-arrow
		position: absolute
		inset: 0
		display: flex
		align-items: center
		justify-content: center
		opacity: 0
		transform: scale(0.5)
		@media (max-width: bp-md - 1px)
			display: none
		transition:
			opacity var(--m3e-duration-medium) var(--m3e-easing-standard),
			transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate)
		> :global(svg)
			width: 3rem
			height: 3rem
			color: #fff
		.m3-blog-postcard:hover &
			opacity: 1
			transform: scale(1)

	&__enter
		position: absolute
		top: 0.75rem
		right: 0.75rem
		bottom: 0.75rem
		display: flex
		align-items: center
		justify-content: center
		width: 3.25rem
		border-radius: var(--shape-corner-s)
		background: var(--enter-btn-bg)
		color: var(--primary)
		text-decoration: none
		transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)
		> :global(svg)
			width: 2.25rem
			height: 2.25rem
		.m3-blog-postcard:hover &
			background: var(--enter-btn-bg-hover)
			color: var(--primary)
		@media (max-width: bp-md - 1px)
			display: none

	@media (--m3e-bp-md)
		flex-direction: column
		&--cover &__body
			padding-right: calc(28% + 1.5rem)
		/* 无封面时给右侧进入按钮（3.25rem + 0.75rem 边距）预留空间，描述提前换行 */
		&:not(.m3-blog-postcard--cover) &__body
			padding-right: 4.75rem

	/* === 移动端：封面置顶布局优化（桌面端保持不动） === */
	@media (max-width: bp-md - 1px)
		/* 原始设计：标题竖线仅桌面显示 */
		.m3-blog-postcard__title :global(.m3-accent-bar)
			display: none

		/* 封面内缩置顶：四周留 1rem、2:1 宽比、0.75rem 圆角 */
		&__cover
			width: auto
			aspect-ratio: 2 / 1
			margin: 1rem 1rem 0
			border-radius: var(--shape-corner-m)
			> img
				width: 100%
				height: 100%

		/* 正文统一 1rem 内边距 */
		&__body
			padding: 1rem

		/* 原始设计：标题尾部箭头 2rem */
		&__arrow
			width: 2rem
			height: 2rem
</style>
