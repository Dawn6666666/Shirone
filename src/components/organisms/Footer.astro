---
/**
 * 页脚（消费 blog/FooterBar 原子）。
 * 只负责配置数据：版权名称/年份、RSS/Sitemap 链接、Powered by。
 */
import { url } from "@utils/url-utils";
import { profileConfig } from "@/config";
import FooterBar from "@components/atoms/blog/FooterBar.astro";

const currentYear = new Date().getFullYear();
const links = [
	{ label: "RSS", href: url("rss.xml"), external: true },
	{ label: "Sitemap", href: url("sitemap-index.xml"), external: true },
];
const poweredBy = [
	{ label: "Astro", href: "https://astro.build", external: true },
	{ label: "Shirone", href: "https://github.com/LyraVoid/Shirone", external: true },
];
---

<FooterBar name={profileConfig.name} year={currentYear} links={links} poweredBy={poweredBy} />
