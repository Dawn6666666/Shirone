---
interface Props {
	class: string;
}
const className = Astro.props.class;
---
<div data-pagefind-body class={`prose dark:prose-invert prose-base !max-w-none custom-md markdown-content ${className}`}>
	<slot />
</div>

<style lang="stylus" is:global>
@import "../../styles/markdown-extend.styl"
</style>

<script>
	import { initCodeCopyButtons } from "@utils/code-copy";
	import { initCodeTrees } from "@utils/code-tree";

	initCodeCopyButtons();
	initCodeTrees();

	const OPTION_GROUP_SELECTOR = ".m3-option-group[data-option-group]";
	const OPTION_GROUP_LOADER_BOUND = "optionGroupLoaderBound";
	const initOptionGroupsWhenPresent = async () => {
		if (!document.querySelector(OPTION_GROUP_SELECTOR)) return;
		const { initOptionGroups } = await import("@utils/option-groups");
		initOptionGroups();
	};

	if (document.documentElement.dataset[OPTION_GROUP_LOADER_BOUND] !== "true") {
		document.documentElement.dataset[OPTION_GROUP_LOADER_BOUND] = "true";
		void initOptionGroupsWhenPresent();
		document.addEventListener("swup:content:replace", () => {
			void initOptionGroupsWhenPresent();
		});
	}
</script>
