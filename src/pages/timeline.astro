---
/** 时间线页：配置层数据在构建期传入交互岛，路由仅负责开关与编排。 */
import TimelineSection from "@components/organisms/TimelineSection.svelte";
import { timelineConfig } from "@/config/timelineConfig";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";

if (!timelineConfig.enable) {
	return Astro.redirect("/404/");
}
---

<MainGridLayout
	title={i18n(I18nKey.timeline)}
	description={i18n(I18nKey.timelineBanner)}
	page="timeline"
>
	<TimelineSection
		categories={timelineConfig.categories}
		items={timelineConfig.items}
		client:only="svelte"
	/>
</MainGridLayout>
