---
/** 设备展示页：配置层数据在构建期传入交互岛，路由仅负责开关与编排。 */
import DeviceSection from "@components/organisms/DeviceSection.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { devicesConfig } from "@/config/devicesConfig";

if (!devicesConfig.enable) {
	return Astro.redirect("/404/");
}
---

<MainGridLayout
	title={i18n(I18nKey.devices)}
	description={i18n(I18nKey.devicesBanner)}
	page="devices"
>
	<DeviceSection
		categories={devicesConfig.categories}
		items={devicesConfig.items}
		client:only="svelte"
	/>
</MainGridLayout>