---
import { render } from "astro:content";
import path from "node:path";
import Markdown from "@components/content/Markdown.astro";
import IconButton from "@components/atoms/action/IconButton.svelte";
import ImageWrapper from "@components/molecules/ImageWrapper.astro";
import License from "@components/molecules/License.astro";
import PostMetadata from "@components/molecules/PostMeta.astro";
import AccentBar from "@components/atoms/display/AccentBar.svelte";
import Card from "@components/atoms/display/Card.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { licenseConfig } from "src/config";
import { profileConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const { remarkPluginFrontmatter } = await render(entry);
const imageBasePath = entry.filePath
	? path.relative(path.resolve("src"), path.dirname(entry.filePath))
	: path.join("content/posts/", getDir(entry.id));

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---
<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} headings={headings} postCategory={entry.data.category || undefined}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <Card color="var(--card-bg)" radius="l" id="post-container" class:list={["z-10 px-6 md:px-9 pt-6 pb-4 relative w-full",
            {}
        ]}>
            <!-- word count and reading time -->
            <div class="flex flex-row text-[var(--on-surface-variant)] gap-5 mb-3 transition onload-animation">
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-[var(--btn-regular-bg)] text-[var(--on-surface-variant)] flex items-center justify-center mr-2">
                        <Icon name="material-symbols:notes-rounded"></Icon>
                    </div>
                    <div class="font-[var(--m3e-type-body-medium)]">{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                </div>
                <div class="flex flex-row items-center">
                    <div class="transition h-6 w-6 rounded-md bg-[var(--btn-regular-bg)] text-[var(--on-surface-variant)] flex items-center justify-center mr-2">
                        <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                    </div>
                    <div class="font-[var(--m3e-type-body-medium)]">
                        {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>

            <!-- title -->
            <div class="relative onload-animation">
                <div
                    data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-90 flex items-center gap-3
                ">
                    <AccentBar size="medium" class="!hidden md:!inline-block absolute -left-[1.125rem] top-[0.75rem]" />
                    <span class="min-w-0">{entry.data.title}</span>
                    <IconButton
                        id="copy-post-link"
                        label={i18n(I18nKey.copyLink)}
                        class="ml-auto shrink-0"
                    >
                        <Icon name="material-symbols:link-rounded" class="text-[1.25rem]"></Icon>
                    </IconButton>
                </div>
            </div>

            <!-- metadata -->
            <div class="onload-animation">
                <PostMetadata
                        class="mb-5"
                        published={entry.data.published}
                        updated={entry.data.updated}
                        tags={entry.data.tags}
                        category={entry.data.category}
                ></PostMetadata>
                {!entry.data.image && <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>}
            </div>

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={imageBasePath} class="mb-8 rounded-xl banner-container onload-animation"/>
            }


            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.id} pubDate={entry.data.published} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </Card>
    </div>

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        {entry.data.nextSlug ? (
            <Card
                href={getPostUrlBySlug(entry.data.nextSlug)}
                color="var(--card-bg)"
                radius="l"
                class="post-nav post-nav--prev w-full font-bold active:scale-95 h-[3.75rem] max-w-full px-4 !flex items-center !justify-start gap-4"
            >
                <Icon name="material-symbols:chevron-left-rounded" class="post-nav__arrow text-[2rem] text-[var(--primary)]" />
                <div class="post-nav__title overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-75">
                    {entry.data.nextTitle}
                </div>
            </Card>
        ) : (
            <div class="w-full"></div>
        )}

        {entry.data.prevSlug ? (
            <Card
                href={getPostUrlBySlug(entry.data.prevSlug)}
                color="var(--card-bg)"
                radius="l"
                class="post-nav post-nav--next w-full font-bold active:scale-95 h-[3.75rem] max-w-full px-4 !flex items-center !justify-end gap-4"
            >
                <div class="post-nav__title overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-75">
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="post-nav__arrow text-[2rem] text-[var(--primary)]" />
            </Card>
        ) : (
            <div class="w-full"></div>
        )}
    </div>

</MainGridLayout>

<style is:global lang="stylus">
	/* 上一篇/下一篇卡片 hover 动效：箭头向阅读方向位移、标题转主题色。
	   reduced-motion 由全局 motion-reduced 规则自动降级（过渡禁用） */
	.post-nav
		.post-nav__arrow
			transition: transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate)

		.post-nav__title
			transition: color var(--m3e-duration-short) var(--m3e-easing-standard)

		&:hover .post-nav__title
			color: var(--primary)

		&--prev:hover .post-nav__arrow
			transform: translateX(-0.25rem)

		&--next:hover .post-nav__arrow
			transform: translateX(0.25rem)
</style>

<script>
    import { showSnackbar } from "@utils/snackbar";
    import I18nKey from "@i18n/i18nKey";
    import { i18n } from "@i18n/translation";

    const copyBtn = document.getElementById("copy-post-link");
    copyBtn?.addEventListener("click", async () => {
        try {
            await navigator.clipboard.writeText(window.location.href);
            showSnackbar(i18n(I18nKey.copySuccess), { icon: "material-symbols:link" });
        } catch {
            showSnackbar(i18n(I18nKey.copyLink));
        }
    });
</script>
