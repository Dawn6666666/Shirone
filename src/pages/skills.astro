---
/** 技能页：配置层数据在构建期传入交互岛，路由仅负责开关与编排。 */
import SkillSection from "@components/organisms/SkillSection.svelte";
import { skillsConfig } from "@/config/skillsConfig";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";

if (!skillsConfig.enable) {
	return Astro.redirect("/404/");
}
---

<MainGridLayout title={i18n(I18nKey.skills)} description={i18n(I18nKey.skillsBanner)} page="skills">
	<SkillSection categories={skillsConfig.categories} items={skillsConfig.items} client:only="svelte" />
</MainGridLayout>
