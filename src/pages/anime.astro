---
/**
 * 番剧收藏页：数据经 utils/anime-data（AnimeSource 分发，本地/JSON 可切换）
 * 构建期取得后交给客户端岛渲染（筛选/过渡/加载更多均为交互态）。
 */
import AnimeSection from "@components/organisms/AnimeSection.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getAnimeList } from "../utils/anime-data";
---

<MainGridLayout title={i18n(I18nKey.anime)} description={i18n(I18nKey.animeBanner)} page="anime">
    <AnimeSection animes={getAnimeList()} client:only="svelte"></AnimeSection>
</MainGridLayout>
